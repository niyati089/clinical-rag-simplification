# ── Windows / Environment Suppressors ───────────────────────────────────────
# Suppress TensorFlow oneDNN info messages (harmless, just noisy)
TF_ENABLE_ONEDNN_OPTS=0
# Suppress HuggingFace symlink warning on Windows (caching still works)
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# ── LLM Configuration ────────────────────────────────────────────────────────
# Choose your LLM provider: groq | openai | google | anthropic
LLM_PROVIDER=groq

# Model name for the chosen provider
# Groq:      llama-3.3-70b-versatile | llama-3.1-8b-instant
# OpenAI:    gpt-4o-mini | gpt-4o | gpt-3.5-turbo
# Google:    gemini-1.5-flash | gemini-1.5-pro
# Anthropic: claude-3-haiku-20240307 | claude-3-5-sonnet-20241022
LLM_MODEL=llama-3.3-70b-versatile

# Your API key — NEVER commit the real key to version control
LLM_API_KEY=your_api_key_here

# LLM generation parameters
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500

# ── Embedding Configuration ───────────────────────────────────────────────────
# Sentence-Transformers model for generating embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Chunking ──────────────────────────────────────────────────────────────────
MAX_CHUNK_TOKENS=300
CHUNK_OVERLAP_SENTENCES=1

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K=5

# ── Reranking ─────────────────────────────────────────────────────────────────
USE_RERANKER=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=3

# ── Reading Level ─────────────────────────────────────────────────────────────
# Default reading level: Basic | Intermediate | Advanced
DEFAULT_READING_LEVEL=Basic
